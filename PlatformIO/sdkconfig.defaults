# =============================================================================
# sdkconfig.defaults — Seeed Studio XIAO ESP32S3 Sense
#
# These are the ESP-IDF knobs the Arduino IDE cannot set, which is exactly why
# this example is a PlatformIO arduino+espidf project. Every value here is
# carried over from the ESP-IDF version of this example, where it was tuned
# against the Anedya TURN relay.
# =============================================================================

# --- Arduino ----------------------------------------------------------------
# Required in hybrid mode: without it setup()/loop() are never called.
CONFIG_AUTOSTART_ARDUINO=y
# loop() runs the camera capture, the JPEG hand-off and the MQTT/TLS pump.
# The 8 KB default is tight once PubSubClient's TLS write path and the offer
# decode (ArduinoJson + inflate) are on it.
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384
# Leave ESP_LOGx going to the ESP-IDF console (see console section below) so
# our logs and esp_peer's/esp32-camera's land on the same port, in order.
# CONFIG_ARDUHAL_ESP_LOG is not set

# --- Console ----------------------------------------------------------------
# XIAO ESP32S3 has no USB-UART bridge; the USB-C port is the ESP32-S3's own
# USB peripheral. ARDUINO_USB_MODE=1 (set by the board definition) makes Serial
# the USB Serial/JTAG controller, so point the IDF console there too.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Flash / partitions -----------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# --- PSRAM ------------------------------------------------------------------
# Mandatory. A single HVGA JPEG frame buffer is far larger than the free
# internal DRAM; without PSRAM esp_camera_init() fails outright.
# The XIAO ESP32S3 uses OCTAL SPI PSRAM — quad mode means "no PSRAM found".
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Small allocations stay in internal RAM (DMA-capable); big ones go to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# --- mbedTLS / DTLS (esp_peer) ----------------------------------------------
# esp_peer needs DTLS plus the DTLS-SRTP extension, and self-signs its own
# certificate via mbedtls_x509write_crt_*. The Arduino IDE's precompiled core
# enables DTLS but NOT DTLS_SRTP, which is the hard blocker there.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
# CONFIG_MBEDTLS_SSL_DTLS_CONNECTION_ID is not set
# Route mbedTLS allocations to PSRAM, freeing internal RAM for camera DMA.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Arduino's stock config turns this on; it re-allocates SSL buffers mid-session
# and fights esp_peer's long-lived DTLS association.
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set

# --- mbedTLS / PSK (NetworkClientSecure) ------------------------------------
# Not used for any actual PSK handshake — Anedya's broker is plain server-cert
# TLS. This is here because Arduino's ssl_client.cpp wraps its whole body in
#   #if !defined(MBEDTLS_KEY_EXCHANGE__SOME__PSK_ENABLED) && \
#       !defined(MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED)
#   #warning "...Enable PSK based ciphersuite modes..."
#   #else  ...entire implementation...
# With PSK off the file still compiles, but to an *empty* object, and linking
# NetworkClientSecure then fails with "undefined reference to start_ssl_client"
# and friends. CONFIG_MBEDTLS_PSK_MODES defaults to n in ESP-IDF; the Arduino
# IDE's precompiled core has it on, which is why this only bites when IDF is
# built from source.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# --- Scheduler --------------------------------------------------------------
# 1 ms tick (matches esp_peer's own peer_demo). At the 10 ms default the ICE
# agent's socket polling and STUN/TURN retransmit timers round to coarse
# boundaries, which slows recovery from the packet-loss windows seen while
# gathering TURN relay candidates.
CONFIG_FREERTOS_HZ=1000

# --- Misc -------------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
# esp_peer_pre_generate_cert() (mbedTLS EC keygen, deep bignum call stack) runs
# from the app entry task before loop() starts.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
