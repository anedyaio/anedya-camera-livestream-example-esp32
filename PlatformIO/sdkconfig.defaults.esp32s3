# =============================================================================
# Seeed Studio XIAO ESP32S3 Sense — ESP32-S3, 8 MB flash, 8 MB octal PSRAM.
#
# ESP-IDF merges this on top of sdkconfig.defaults automatically when the build
# target is esp32s3 (PlatformIO env: seeed_xiao_esp32s3).
# =============================================================================

# --- Console ----------------------------------------------------------------
# The XIAO has no USB-UART bridge; the USB-C port is the ESP32-S3's own USB
# peripheral. ARDUINO_USB_MODE=1 (set by the board definition) makes Serial the
# USB Serial/JTAG controller, so point the IDF console at the same peripheral —
# then Serial.printf and ESP_LOGx interleave on one port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Flash / partitions -----------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esp32s3.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.esp32s3.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# --- PSRAM ------------------------------------------------------------------
# Mandatory. A single HVGA JPEG frame buffer is far larger than the free
# internal DRAM; without PSRAM esp_camera_init() fails outright.
# The XIAO ESP32S3 uses OCTAL SPI PSRAM — quad mode means "no PSRAM found".
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Small allocations stay in internal RAM (DMA-capable); big ones go to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# The S3 has no PSRAM cache-corruption erratum, so the quad-chip IRAM
# workaround knobs used on the ESP32 are neither needed nor available here.

# --- CPU --------------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
