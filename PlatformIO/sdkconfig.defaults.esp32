# =============================================================================
# ESP32-CAM style boards (AI Thinker ESP32-CAM, DFRobot and other clones with
# the same module) — ESP32, 4 MB flash, 4 MB quad PSRAM.
#
# ESP-IDF merges this on top of sdkconfig.defaults automatically when the build
# target is esp32 (PlatformIO env: esp32cam).
#
# Values ported verbatim from the ESP-IDF example's sdkconfig.defaults.esp32.
# =============================================================================

# --- Console ----------------------------------------------------------------
# No USB peripheral on the ESP32: the console is UART0 at 115200, reached
# through the external USB-to-serial programmer. That is the ESP-IDF default,
# so nothing to set here — do NOT add CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG.

# --- Flash / partitions -----------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# --- PSRAM ------------------------------------------------------------------
# Mandatory, same as on the S3 — but this module has QUAD PSRAM, not octal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_SPEED=40
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# --- ESP32 PSRAM cache erratum ----------------------------------------------
# The original ESP32 silicon can corrupt data when the CPU accesses PSRAM while
# certain ROM/library code runs from flash. The fix is to relocate the affected
# libc routines into IRAM. This costs internal RAM but is not optional — without
# it, PSRAM access is unreliable. (The Arduino board manifest passes the
# matching -mfix-esp32-psram-cache-issue compiler flag.)
CONFIG_SPIRAM_CACHE_WORKAROUND=y
CONFIG_SPIRAM_CACHE_WORKAROUND_STRATEGY_MEMW=y
CONFIG_SPIRAM_CACHE_LIBJMP_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBMATH_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBNUMPARSER_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBIO_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBTIME_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBCHAR_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBMEM_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBSTR_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBRAND_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBENV_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBFILE_IN_IRAM=y
CONFIG_SPIRAM_CACHE_LIBMISC_IN_IRAM=y
# The ESP32 can only map 4 MB of PSRAM through a 4 MB window; bank switching
# pages the rest in. Reserve 8 banks for it.
CONFIG_SPIRAM_BANKSWITCH_ENABLE=y
CONFIG_SPIRAM_BANKSWITCH_RESERVE=8

# --- CPU --------------------------------------------------------------------
# 160 MHz is the value the ESP-IDF example was tested at on this board.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160
